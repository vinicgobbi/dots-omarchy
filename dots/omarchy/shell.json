{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "birthYear": 2004,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "vinicgobbi.media",
          "showTime": true
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.saiiiiiph.update-center",
          "checkSchedule": "At startup only"
        },
        {
          "id": "vinicgobbi.monitcall"
        },
        {
          "id": "wian47.removable-drives"
        },
        {
          "id": "vinicgobbi.clipboard"
        },
        {
          "id": "omaconnect"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "vinicgobbi.vpn"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "vinicgobbi.battery",
          "showPercentage": false
        },
        {
          "id": "vinicgobbi.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "vinicgobbi.battery"
  ],
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.power"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "yendor.portal"
    }
  ],
  "version": 1
}
