{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "birthYear": 2004,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.media",
          "showPrevious": true,
          "showNext": true,
          "showTime": true
        },
        {
          "id": "vinicgobbi.nowbar",
          "updateInterval": 30,
          "showCount": false,
          "maxWidth": 180
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "vinicgobbi.remote-connections"
        },
        {
          "id": "vinicgobbi.monitcall"
        },
        {
          "id": "wian47.removable-drives"
        },
        {
          "id": "vinicgobbi.clipboard"
        },
        {
          "id": "omaconnect"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "vinicgobbi.vpn"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "vinicgobbi.battery",
          "showPercentage": false
        },
        {
          "id": "vinicgobbi.power",
          "confirm": false
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "vinicgobbi.battery"
  ],
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.power"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "yendor.portal"
    },
    {
      "id": "trinity-bytes.lock-keys-osd"
    }
  ],
  "version": 1
}
